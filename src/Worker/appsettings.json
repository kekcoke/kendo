{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Resilience": {
    "Retry": {
      "MaxRetries": 3,
      "BaseDelayMs": 100,
      "MaxDelayMs": 2000,
      "UseJitter": true
    },
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "BreakDurationSeconds": 30,
      "SamplingDurationSeconds": 30
    }
  }
}
