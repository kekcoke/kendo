{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "Retry": {
      "MaxRetries": 3,
      "BaseDelayMs": 100,
      "MaxDelayMs": 2000,
      "UseJitter": true
    },
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "BreakDurationSeconds": 30,
      "SamplingDurationSeconds": 30
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RateLimiting": {
    "FixedWindow": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 10
    },
    "Concurrency": {
      "MaxConcurrency": 50,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 5
    }
  }
}
