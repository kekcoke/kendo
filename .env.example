# Kendo Platform — Environment Variables
# Copy to .env and fill in values for local development

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# JWT Authentication (Gateway)
KENDO__JWT__PRIVATE_KEY_PATH=secrets/jwt-private.pem
KENDO__JWT__ISSUER=https://gateway.local/.well-known/jwks.json
KENDO__JWT__AUDIENCE=kendo.api
KENDO__JWT__ROTATION_DAYS=90
KENDO__JWT__TOKEN_LIFETIME_MINUTES=60
KENDO__JWT__SERVICE_TOKEN_LIFETIME_SECONDS=60

# FastAPI Service (when available)
KENDO__FASTAPI__BASE_URL=http://fastapi:8000
KENDO__FASTAPI__TIMEOUT_SECONDS=30
KENDO__FASTAPI__CIRCUIT_BREAKER_FAILURES=3
KENDO__FASTAPI__CIRCUIT_BREAKER_BREAK_SECONDS=30

# AI Queue (kendo-events-ai) — Rebus consumer config
REBUS__AIWORKERS=2
REBUS__AIPARALLELISM=5
REBUS__AIDLQ_DEPTH_THRESHOLD=5