# Kendo Platform — Environment Variables
# Copy to .env and fill in values for local development

ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# =============================================================================
# .NET Services — Connection Strings
# =============================================================================

# PostgreSQL (kendo_users DB — used by UserService + Worker)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=kendo_users;Username=kendo;Password=kendo_dev

# Redis distributed cache (used by Gateway, UserService, Worker)
Redis__ConnectionString=redis:6379

# =============================================================================
# Azure Service Bus — Rebus Messaging
# =============================================================================

# Connection string for Azure Service Bus (leave empty for local dev — auto-skips)
Rebus__ConnectionString=

# Main consumer: worker threads and parallelism for kendo-events queue
# (configured via appsettings.json — documented here for reference)
# Rebus__Workers=3
# Rebus__Parallelism=10

# AI queue (kendo-events-ai) — Rebus consumer config
Rebus__AiWorkers=2
Rebus__AiParallelism=5
Rebus__AiDlqDepthThreshold=5

# Dead Letter Queue — opt-in consumer (disabled by default)
Rebus__DlqConsumerEnabled=false

# =============================================================================
# JWT Authentication (Gateway)
# =============================================================================

KENDO__JWT__PRIVATE_KEY_PATH=secrets/jwt-private.pem
KENDO__JWT__ISSUER=https://gateway.local/.well-known/jwks.json
KENDO__JWT__AUDIENCE=kendo.api
KENDO__JWT__ROTATION_DAYS=90
KENDO__JWT__TOKEN_LIFETIME_MINUTES=60
KENDO__JWT__SERVICE_TOKEN_LIFETIME_SECONDS=60

# =============================================================================
# FastAPI Service — Gateway Proxy Config
# =============================================================================

KENDO__FASTAPI__BASE_URL=http://fastapi:8000
KENDO__FASTAPI__TIMEOUT_SECONDS=30
KENDO__FASTAPI__CIRCUIT_BREAKER_FAILURES=3
KENDO__FASTAPI__CIRCUIT_BREAKER_BREAK_SECONDS=30

# =============================================================================
# FastAPI Service — Internal Settings
# =============================================================================

FASTAPI__ENV=development
FASTAPI__SERVICE_NAME=kendo-fastapi
FASTAPI__HOST=0.0.0.0
FASTAPI__PORT=8000
FASTAPI__LOG_LEVEL=info
FASTAPI__RELOAD=true

# JWT Auth for FastAPI (must match Gateway issuer)
FASTAPI__JWT__JWKS_URL=http://gateway:5000/.well-known/jwks.json
FASTAPI__JWT__AUDIENCE=kendo.api
FASTAPI__JWT__ISSUER=https://gateway.local/.well-known/jwks.json

# pgvector read-only connection (fastapi_ro role)
FASTAPI__VECTOR__READ_DSN=postgresql://fastapi_ro:fastapi_ro_pw@postgres:5432/kendo_users

# =============================================================================
# FastAPI Service — LLM / Azure OpenAI
# =============================================================================

FASTAPI__LLM__ENDPOINT=https://your-openai.openai.azure.com
FASTAPI__LLM__API_KEY=
FASTAPI__LLM__DEPLOYMENT_NAME=gpt-4o
FASTAPI__LLM__API_VERSION=2024-02-15-preview

# =============================================================================
# FastAPI Service — Embedding Model
# =============================================================================

FASTAPI__EMBEDDING_MODEL=BGE-large-en-v1.5
FASTAPI__EMBEDDING_DIMENSION=1024

# =============================================================================
# FastAPI Service — Rate Limiting
# =============================================================================

FASTAPI__RATE_LIMIT__TOKENS_PER_WINDOW=100
FASTAPI__RATE_LIMIT__WINDOW_SECONDS=60
FASTAPI__RATE_LIMIT__BUCKET_CAPACITY=100

# =============================================================================
# FastAPI Service — Resilience (pybreaker)
# =============================================================================

FASTAPI__BREAKER_PGVECTOR_FAIL_MAX=3
FASTAPI__BREAKER_PGVECTOR_RESET_TIMEOUT=30
FASTAPI__BREAKER_OPENAI_FAIL_MAX=3
FASTAPI__BREAKER_OPENAI_RESET_TIMEOUT=30

# =============================================================================
# FastAPI Service — Resilience (tenacity retry)
# =============================================================================

FASTAPI__RETRY_MAX_ATTEMPTS=3
FASTAPI__RETRY_MIN_WAIT=1.0
FASTAPI__RETRY_MAX_WAIT=30.0
FASTAPI__RETRY_MULTIPLIER=2.0

# =============================================================================
# FastAPI Service — OpenTelemetry / Observability
# =============================================================================

FASTAPI__OTEL_SERVICE_NAME=kendo-fastapi
# Empty = console exporter fallback. Set to OTLP gRPC endpoint in production.
FASTAPI__OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# FastAPI Service — W4 Intent Classifier
# =============================================================================

FASTAPI__INTENT_CLASSIFIER_MODEL=gpt-4o-mini

# =============================================================================
# FastAPI Service — W5 UserService Integration (backfill)
# =============================================================================

FASTAPI__USER_SERVICE_BASE_URL=http://userservice:5001
FASTAPI__USER_SERVICE_TIMEOUT=30

# =============================================================================
# User Embedding Configuration (UserService)
# =============================================================================

KENDO__EVENT_EMBEDDING__DIM=1024
KENDO__EVENT_EMBEDDING__MODEL=BGE-large-en-v1.5
